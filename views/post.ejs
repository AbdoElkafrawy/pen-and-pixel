<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">

    <title>🖋️ Pen & Pixel</title>
     

</head>
<body>

    <header>
        <h1>🖋️ Pen & Pixel</h1>
        <a href="/" class="new-post-btn">← Back to Home</a>
    </header>

    <main class="form-container"> 
     
        <h1><%= post.title %></h1>

        <% if (post.image) { %>
            <img src="<%= post.image %>" alt="<%= post.title %>" class="post-image">
        <% } %>

        <p class="post-meta single">📅 <%= post.createdAtDisplay || post.createdAt %></p>

        <p><%= post.content %></p>

        <!-- 👇 edit & delete post action buttons 👇 -->
    <div class="post-actions">
        <a class="edit-btn" href="/posts/<%= post.id %>/edit">Edit</a>
        
        <form action="/posts/<%= post.id %>/delete" method="POST">
            <button class="delete-btn" onclick="return confirm('Delete this post?')" type="submit">
                Delete
            </button>
        </form>
    </div>

    </main>
         
    <script src="/js/script.js"></script>

</body>
</html>