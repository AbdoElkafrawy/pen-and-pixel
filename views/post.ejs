<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head", { title: post.title + " — Pen & Pixel" }) %>
</head>
<body>

    <%- include("partials/header") %>

    <main class="form-container"> 
     
        <h1><%= post.title %></h1>

        <% if (post.image) { %>
            <img src="<%= post.image %>" alt="<%= post.title %>" class="post-image single-post-image">
        <% } %>

        <p class="post-meta single">
            📅 <%= post.createdAtDisplay || post.createdAt %> • ⏱️ <%= post.readingTime %> min read
            <% if (post.author && post.author.name) { %>
                • <a href="/?author=<%= encodeURIComponent(post.author.name) %>" class="author-filter-link">✍️ <%= post.author.name %></a>
            <% } %>
        </p>

        <p class="post-body"><%= post.content %></p>

        <!-- Like button and Actions (Owner or Admin) -->
        <div class="single-post-footer">
            <button
                class="like-btn like-btn-large"
                data-post-id="<%= post._id %>"
                aria-label="Like this post"
            >
                ❤️ <span class="like-count"><%= post.likes || 0 %></span> Likes
            </button>

            <% const canEditSingle = isAdmin || (currentUser && post.author && post.author.id && String(post.author.id) === String(currentUser._id)); %>
            <% if (canEditSingle) { %>
                <div class="post-actions">
                    <a class="edit-btn" href="/posts/<%= post._id %>/edit">Edit</a>
                    <form action="/posts/<%= post._id %>/delete" method="POST">
                        <button class="delete-btn" onclick="return confirm('Delete this post?')" type="submit">
                            Delete
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <!-- =======================================================
                            COMMENTS SECTION
        ======================================================= -->
        <section class="comments-section" id="comments">
            <h3>💬 Comments (<%= (post.comments || []).length %>)</h3>

            <!-- List of existing comments -->
            <div class="comments-list">
                <% if (!post.comments || post.comments.length === 0) { %>
                    <p class="no-comments">No comments yet. Be the first to join the discussion!</p>
                <% } else { %>
                    <% post.comments.forEach(comment => { %>
                        <div class="comment-card">
                            <div class="comment-header">
                                <span class="comment-author">
                                    <% if (comment.authorAvatar) { %>
                                        <img src="<%= comment.authorAvatar %>" alt="" class="comment-avatar-small">
                                    <% } else { %>
                                        👤 
                                    <% } %>
                                    <%= comment.authorName || 'Anonymous' %>
                                </span>
                                <span class="comment-date">
                                    <%= new Date(comment.createdAt).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit" }) %>
                                </span>
                            </div>

                            <p class="comment-text"><%= comment.text %></p>

                            <% if (isAdmin) { %>
                                <form action="/posts/<%= post._id %>/comments/<%= comment._id %>/delete" method="POST" class="delete-comment-form">
                                    <button type="submit" class="delete-comment-btn" onclick="return confirm('Delete this comment?')">
                                        🗑️ Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Form to post a new comment -->
            <form action="/posts/<%= post._id %>/comments" method="POST" class="add-comment-form">
                <h4>✍️ Leave a Comment</h4>
                <div class="form-group">
                    <textarea
                        name="text"
                        placeholder="Write your comment..."
                        required
                        rows="3"
                    ></textarea>
                </div>
                <button type="submit" class="submit-btn comment-submit-btn">Post Comment</button>
            </form>
        </section>

    </main>

    <%- include("partials/footer") %>