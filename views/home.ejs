<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head", { title: "🖋️ Pen & Pixel — Modern Magazine Blog" }) %>
</head>
<body>

    <%- include("partials/header") %>

    <main>
        <!-- =======================================================
                            HERO BANNER
        ======================================================= -->
        <section class="hero">
            <div class="hero-card-box">
                <span class="hero-badge">✨ Welcome to Pen &amp; Pixel</span>
                <h2>Every great creation begins with a single thought.</h2>
                <p>Write yours.</p>

                <% if (isAdmin) { %>
                    <a href="/new" class="hero-btn">Start Writing</a>
                <% } %>
            </div>
        </section>


        <!-- =======================================================
                 SIDE-BY-SIDE WIDGETS (Weather & Quote)
        ======================================================= -->
        <section class="widgets-bar">
            <% if (weather) { %>
                <div class="weather-card">
                    <h3>📍 <%= weather.city %></h3>
                    <div class="weather-temp">
                        <%= Math.round(weather.temperature) %>°C
                    </div>
                    <p class="weather-desc"><%= weather.description %></p>
                    <p class="weather-feels">
                        Feels like <strong><%= Math.round(weather.feelsLike) %>°C</strong>
                    </p>
                </div>
            <% } %>

            <% if (quote) { %>
                <div class="quote-card">
                    <h3>💬 Quote of the Day</h3>
                    <blockquote>"<%= quote.text %>"</blockquote>
                    <p class="quote-author">— <%= quote.author %></p>
                </div>
            <% } %>
        </section>


        <!-- =======================================================
                       MAGAZINE POSTS FEED
        ======================================================= -->
        <section class="posts-magazine">

            <% if (search) { %>
                <h2 class="posts-heading">
                    Search Results for "<%= search %>" — <%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %>
                </h2>
            <% } else if (typeof currentAuthor !== 'undefined' && currentAuthor) { %>
                <h2 class="posts-heading">Showing Posts by Author: "✍️ <%= currentAuthor %>" — <%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %> <a href="/" class="clear-search-btn" style="font-size:0.8rem; margin-left: 10px;">Clear Filter</a></h2>
            <% } else if (currentCategory && currentCategory !== 'All') { %>
                <h2 class="posts-heading">Showing Category: "<%= currentCategory %>" — <%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></h2>
            <% } else { %>
                <h2 class="posts-heading">🔥 Top Stories &amp; Latest Posts</h2>
            <% } %>
            
            <% if (posts.length === 0) { %>
                <% if (search) { %>
                    <p class="empty-message">No posts found matching "<%= search %>".</p>
                <% } else { %>
                    <p class="empty-message">No posts yet. Be the first to write one!</p>
                <% } %>
            <% } %>

            <!-- When not searching and we have posts, render the FIRST post as a Featured Hero Card -->
            <% if (!search && posts.length > 0) { %>
                <% const featuredPost = posts[0]; %>
                <article class="post-card featured-hero-card">
                    <div class="featured-badge">⭐ Featured Story</div>
                    
                    <% if (featuredPost.image) { %>
                        <img src="<%= featuredPost.image %>" alt="<%= featuredPost.title %>" class="post-image featured-image">
                    <% } %>

                    <div class="featured-content">
                        <div class="post-header">
                            <span class="card-category-tag"><%= featuredPost.category || 'General' %></span>
                            <h2><a href="/posts/<%= featuredPost.id %>"><%= featuredPost.title %></a></h2>
                            <p class="post-meta">
                                📅 <%= featuredPost.createdAtDisplay || featuredPost.createdAt %> • ⏱️ <%= featuredPost.readingTime %> min read
                                <% if (featuredPost.author && featuredPost.author.name) { %>
                                    • <a href="/?author=<%= encodeURIComponent(featuredPost.author.name) %>" class="author-filter-link">✍️ <%= featuredPost.author.name %></a>
                                <% } %>
                            </p>
                        </div>

                        <div class="post-body">
                            <p>
                                <% if (featuredPost.content.length > 280) { %>
                                    <%= featuredPost.content.substring(0, 280) %>...
                                <% } else { %>
                                    <%= featuredPost.content %>
                                <% } %>
                            </p>
                        </div>

                        <div class="post-footer">
                            <a href="/posts/<%= featuredPost.id %>" class="read-more">Read Full Story &rarr;</a>

                            <div class="post-footer-right">
                                <a href="/posts/<%= featuredPost.id %>#comments" class="comments-badge" title="View comments">
                                    💬 <span class="comment-count"><%= (featuredPost.comments || []).length %></span>
                                </a>

                                <button
                                    class="like-btn"
                                    data-post-id="<%= featuredPost.id %>"
                                    aria-label="Like this post"
                                >
                                    ❤️ <span class="like-count"><%= featuredPost.likes || 0 %></span>
                                </button>

                                <% const canEditFeatured = isAdmin || (currentUser && featuredPost.author && featuredPost.author.id && String(featuredPost.author.id) === String(currentUser._id)); %>
                                <% if (canEditFeatured) { %>
                                    <div class="post-actions">
                                        <a class="edit-btn" href="/posts/<%= featuredPost.id %>/edit">Edit</a>
                                        <form action="/posts/<%= featuredPost.id %>/delete" method="POST">
                                            <button class="delete-btn" onclick="return confirm('Delete this post?')" type="submit">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </article>
            <% } %>


            <!-- Render remaining posts (or all search results) in a 2-Column Grid -->
            <% const gridPosts = (!search && posts.length > 0) ? posts.slice(1) : posts; %>

            <% if (gridPosts.length > 0) { %>
                <div class="posts-grid">
                    <% gridPosts.forEach((post) => { %>
                        <article class="post-card grid-card">
                            <% if (post.image) { %>
                                <img src="<%= post.image %>" alt="<%= post.title %>" class="post-image grid-image">
                            <% } %>

                            <div class="post-header">
                                <span class="card-category-tag"><%= post.category || 'General' %></span>
                                <h2><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
                                <p class="post-meta">
                                    📅 <%= post.createdAtDisplay || post.createdAt %> • ⏱️ <%= post.readingTime %> min read
                                    <% if (post.author && post.author.name) { %>
                                        • <a href="/?author=<%= encodeURIComponent(post.author.name) %>" class="author-filter-link">✍️ <%= post.author.name %></a>
                                    <% } %>
                                </p>
                            </div>

                            <div class="post-body">
                                <p>
                                    <% if (post.content.length > 150) { %>
                                        <%= post.content.substring(0, 150) %>...
                                    <% } else { %>
                                        <%= post.content %>
                                    <% } %>
                                </p>
                            </div>

                            <div class="post-footer">
                                <a href="/posts/<%= post.id %>" class="read-more">Read More &rarr;</a>

                                <div class="post-footer-right">
                                    <a href="/posts/<%= post.id %>#comments" class="comments-badge" title="View comments">
                                        💬 <span class="comment-count"><%= (post.comments || []).length %></span>
                                    </a>

                                    <button
                                        class="like-btn"
                                        data-post-id="<%= post.id %>"
                                        aria-label="Like this post"
                                    >
                                        ❤️ <span class="like-count"><%= post.likes || 0 %></span>
                                    </button>

                                    <% const canEdit = isAdmin || (currentUser && post.author && post.author.id && String(post.author.id) === String(currentUser._id)); %>
                                    <% if (canEdit) { %>
                                        <div class="post-actions">
                                            <a class="edit-btn" href="/posts/<%= post.id %>/edit">Edit</a>
                                            <form action="/posts/<%= post.id %>/delete" method="POST">
                                                <button class="delete-btn" onclick="return confirm('Delete this post?')" type="submit">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } %>

        </section>
    </main>

    <%- include("partials/footer") %>
