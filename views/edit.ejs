<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>new post</title>
</head>
<body>
    
     
    <form action="/posts/<%= post.id %>/edit" method="POST">

        
        <input 
        type="text" 
        name="title" 
        value="<%= post.title%>" 
        placeholder="Title">
        
        <textarea 
        name="content" 
        placeholder="edit your post here..."> <%= post.content %> </textarea>

        <button type="submit">Save Changes</button>
    </form>

</body>
</html>