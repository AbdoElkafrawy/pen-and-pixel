<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head", { title: "🔒 Admin Login — Pen & Pixel" }) %>
</head>
<body>

    <%- include("partials/header") %>

    <main class="form-container" style="max-width: 460px;">

        <h2 class="form-heading">🔒 Admin Login</h2>

        <!-- Login Failure Error Alert -->
        <% if (error) { %>
            <div class="login-error">
                ❌ <%= error %>
            </div>
        <% } %>

        <!-- Google Sign-In Option -->
        <div style="text-align: center; margin-bottom: 25px; margin-top: 10px;">
            <a href="/auth/google" class="google-signin-btn" style="padding: 10px 20px; font-size: 0.95rem; width: 100%; justify-content: center; box-sizing: border-box;">
                <svg width="18" height="18" viewBox="0 0 24 24" style="margin-right: 8px; vertical-align: middle;">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.11 0-5.74-2.1-6.68-4.93H1.28v3.15C3.25 21.3 7.31 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.32 14.27c-.24-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.28C.46 8.21 0 10.05 0 12s.46 3.79 1.28 5.42l4.04-3.15z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.7 1.28 6.58l4.04 3.15c.94-2.83 3.57-4.98 6.68-4.98z"/>
                </svg>
                Sign in with Google Account
            </a>
            <div style="margin: 20px 0 15px 0; font-size: 0.8rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">— Admin Password Login —</div>
        </div>

        <form action="/login" method="POST" class="post-form">

            <div class="form-group">
                <label for="password">Password <span class="required">*</span></label>
                <input
                    id="password"
                    type="password"
                    name="password"
                    placeholder="Enter admin password..."
                    required
                    autofocus
                >
            </div>

            <div class="form-actions">
                <button type="submit" class="submit-btn">Log In</button>
                <a href="/" class="cancel-btn">Cancel</a>
            </div>

        </form>

    </main>

    <%- include("partials/footer") %>
